Restore AX88179A-family state after USB reset

Drain bulk URBs in pre_reset, drop the duplicate TX NAPI enable/tasklet
disable in post_reset, reinitialize firmware mode and hardware (hw_init)
for AX88179A/772D, force a link event, replay rx mode, and make hw_init
program TX checksum offload from netdev->features. Failure returns an
error so the USB core re-probes the interface.

--- a/src/ax_main.c
+++ b/src/ax_main.c
@@ -2791,6 +2791,9 @@
 #else
 	napi_disable(&axdev->rx_napi);
 #endif
+	/* USB reset requires all bulk I/O to be stopped first. */
+	ax_kill_tx_urbs(axdev);
+	ax_stop_rx(axdev);
 	return 0;
 }
 
@@ -2798,7 +2801,7 @@
 {
 	struct ax_device *axdev = usb_get_intfdata(intf);
 	struct net_device *netdev;
-	int i;
+	int i, ret = 0;
 
 	if (!axdev)
 		return 0;
@@ -2807,20 +2810,42 @@
 	if (!netif_running(netdev))
 		return 0;
 
+	/* Reset loses firmware/PHY state; reinitialize as ax_open() does. */
+	if (axdev->chip_version == AX_VERSION_AX88179A_772D) {
+		u16 endpoints = 0;
+
+#ifdef ENABLE_QUEUE_PRIORITY
+		endpoints |= AX_USB_EP5_EN;
+#endif
+#ifdef ENABLE_PTP_FUNC
+		endpoints |= AX_USB_EP4_EN;
+#endif
+		mutex_lock(&axdev->control);
+		ret = ax_write_cmd_nopm(axdev, AX_FW_MODE, AX_FW_MODE_179A,
+					endpoints, 0, NULL);
+		if (ret >= 0)
+			ret = axdev->driver_info->hw_init(axdev, 1);
+		mutex_unlock(&axdev->control);
+		if (ret < 0)
+			goto enable_polling;
+		/* Force a link event so link_reset() restores RX. */
+		netif_carrier_off(netdev);
+	}
+
 	set_bit(AX_ENABLE, &axdev->flags);
+	if (axdev->chip_version == AX_VERSION_AX88179A_772D) {
+		/* Replay rx mode; changes made while disabled were dropped. */
+		netif_addr_lock_bh(netdev);
+		ax88179a_set_multicast(netdev);
+		netif_addr_unlock_bh(netdev);
+	}
 	if (netif_carrier_ok(netdev)) {
 		mutex_lock(&axdev->control);
 		ax_start_rx(axdev);
 		mutex_unlock(&axdev->control);
 	}
-	
-	for (i = 0; i < axdev->driver_info->tx_num; i++)
-#ifdef ENABLE_TX_TASKLET
-		tasklet_disable(&axdev->tx_tl[i]);
-#else
-		napi_enable(&axdev->tx_napi[i]);
-#endif
 
+enable_polling:
 #ifdef ENABLE_RX_TASKLET
 	tasklet_enable(&axdev->rx_tl);
 #else
@@ -2834,6 +2859,10 @@
 		napi_enable(&axdev->tx_napi[i]);
 #endif
 
+	/* Nonzero makes the USB core unbind and re-probe the interface. */
+	if (ret < 0)
+		return ret;
+
 	if (axdev->chip_version == AX_VERSION_AX88279A)
 		netif_tx_wake_all_queues(netdev);
 	else
--- a/src/ax88179a_772d.c
+++ b/src/ax88179a_772d.c
@@ -1665,11 +1665,12 @@
 	if (ret < 0)
 		return ret;
 
-	reg8 = 	AX_TXCOE_IP 	| 
-			AX_TXCOE_TCP 	| 
-			AX_TXCOE_UDP 	|
-	       	AX_TXCOE_TCPV6 	| 
-			AX_TXCOE_UDPV6;
+	/* Follow the configured features; ndo_set_features toggles bits. */
+	reg8 = AX_TXCOE_IP;
+	if (axdev->netdev->features & NETIF_F_IP_CSUM)
+		reg8 |= AX_TXCOE_TCP | AX_TXCOE_UDP;
+	if (axdev->netdev->features & NETIF_F_IPV6_CSUM)
+		reg8 |= AX_TXCOE_TCPV6 | AX_TXCOE_UDPV6;
 	ret = fnw(axdev, AX_ACCESS_MAC, AX_TXCOE_CTL, 1, 1, &reg8);
 	if (ret < 0)
 		return ret;
